file = {:C$\backslash$:/Users/evert/OneDrive - Delft University of Technology/Lifelong Learning for an Origami Robot/Literatuur studie/Literatuur/Ze et al. - 2022 - Soft robotic origami crawler.pdf:pdf},
issn = {23752548},
journal = {Science Advances},
keywords = {crawler,design,origami,soft robot},
