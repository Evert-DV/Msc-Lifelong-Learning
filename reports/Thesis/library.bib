title = {{Model-Based Reinforcement Learning for Closed-Loop Dynamic Control of Soft Robotic Manipulators}},
url = {https://ieeexplore.ieee.org/document/8531756/},
volume = {35},
year = {2019}
}
@article{Zhang2018,
abstract = {In this paper, the bistable behaviour of a deployable cylinder based on origami with Kresling pattern is studied. Firstly, the geometric formulation and closure condition of cylinder with different initial configuration is presented. Bistable configurations and the existence condition of bistable behaviour are obtained through the root analysis of a quadratic function with one-variable. Then, the folding phases are shown to analyse incompatibility during the development. Lastly, finite element predictions using truss systems valid the theoretical formulation and geometric parameter of bistable behaviour.},
