keywords = {architectures,blackbox,detecting shifts,dual,online,policy learning},
mendeley-tags = {architectures,blackbox,detecting shifts,dual,online,policy learning},
month = {dec},
title = {{Adaptive Online Planning for Continual Lifelong Learning}},
url = {http://arxiv.org/abs/1912.01188},
year = {2019}
}
