keywords = {architectures,detecting shift,dual,online,storage {\&} retrieval},
mendeley-tags = {architectures,detecting shift,dual,online,storage {\&} retrieval},
month = {oct},
title = {{Towards semi-episodic learning for robot damage recovery}},
url = {http://arxiv.org/abs/1610.01407},
year = {2016}
}
@article{Masana1993,
abstract = {Structures inspired by the Kresling origami pattern have recently emerged as a foundation for building functional engineering{\&}{\#}xD;systems with versatile characteristics that target niche applications spanning different technological fields. Their light weight,{\&}{\#}xD;deployability, modularity, and customizability are a few of the key characteristics that continue to drive their implementation{\&}{\#}xD;in robotics, aerospace structures, metamaterial and sensor design, switching, actuation, energy harvesting and absorption,{\&}{\#}xD;and wireless communications, among many other examples. This work aims to perform a systematic review of the literature{\&}{\#}xD;to assess the potential of the Kresling origami springs as a structural component for engineering design keeping three{\&}{\#}xD;objectives in mind: i) facilitating future research by summarizing and categorizing the current literature, ii) identifying the current{\&}{\#}xD;shortcomings and voids, and iii) proposing directions for future research to fill those voids.{\&}{\#}xD;},
