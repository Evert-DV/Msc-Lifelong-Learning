}
@inproceedings{Nguyen-Tuong2008,
abstract = {Learning in real-time applications, e.g., online approximation of the inverse dynamics model for model-based robot control, requires fast online regression techniques. Inspired by local learning, we propose a method to speed up standard Gaussian process regression (GPR) with local GP models (LGP). The training data is partitioned in local regions, for each an individual GP model is trained. The prediction for a query point is performed by weighted estimation using nearby local models. Unlike other GP approximations, such as mixtures of experts, we use a distance based measure for partitioning of the data and weighted prediction. The proposed method achieves online learning and prediction in real-time. Comparisons with other non-parametric regression methods show that LGP has higher accuracy than LWPR and close to the performance of standard GPR and $\nu$-SVR.},
author = {Nguyen-Tuong, Duy and Seeger, Matthias and Peters, Jan},
booktitle = {NIPS'08: Proceedings of the 21st International Conference on Neural Information Processing Systems},
doi = {10.5555/2981780.2981929},
file = {:C$\backslash$:/Users/evert/OneDrive - Delft University of Technology/Lifelong Learning for an Origami Robot/Literatuur studie/Literatuur/Nguyen-Tuong, Seeger, Peters - 2008 - Local Gaussian Process Regression for Real Time Online Model Learning and Control.pdf:pdf},
keywords = {blackbox,inverse dynamic model,model learning,online},
mendeley-tags = {blackbox,inverse dynamic model,model learning,online},
pages = {1193--1200},
title = {{Local Gaussian Process Regression for Real Time Online Model Learning and Control.}},
